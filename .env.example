# LeadIntellect Environment Configuration

# 1. Production Database: MongoDB Atlas Connection String
# Get your free URI at https://cloud.mongodb.com/
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/leadintellect?retryWrites=true&w=majority
MONGODB_URI=

# 2. CRM / Slack Webhook Integration
# Enter your Slack Incoming Webhook URL, Zapier Webhook, or HubSpot Webhook URL to automatically receive live lead alerts.
CRM_WEBHOOK_URL=

# 3. Notification Email
# Email address where demo and trial alerts are sent.
NOTIFICATION_EMAIL=sales@leadintellect.ai

# 4. 3rd-Party Waterfall Data & Deliverability Verification Providers
# ZeroBounce API Key (For 99%+ real-time SMTP handshake & catch-all bounce prevention)
ZEROBOUNCE_API_KEY=

# Apollo.io API Key (Primary B2B contact match API)
APOLLO_API_KEY=

# Hunter.io API Key (Secondary domain waterfall fallback)
HUNTER_API_KEY=

# Twilio / Numverify API Key (Direct mobile vs landline carrier verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
